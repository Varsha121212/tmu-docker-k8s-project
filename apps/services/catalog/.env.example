# Copy to .env and fill in real values. .env is gitignored - never commit it.

ENV=local

DATABASE_URL=postgresql+psycopg://catalog_app:CHANGE_ME_APP@localhost:5432/bookstore
MIGRATION_DATABASE_URL=postgresql+psycopg://catalog_migrator:CHANGE_ME_MIGRATIONS@localhost:5432/bookstore

# JWT signing secret - MUST be identical across all five services.
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
