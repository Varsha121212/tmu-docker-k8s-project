# Copy to .env and fill in real values. .env is gitignored - never commit it.

ENV=local

# Memurai/Redis - Cart's only data store (SDD 8.3, SDD 7.4).
REDIS_URL=redis://localhost:6379/0

# JWT signing secret - MUST be identical across all five services.
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256

# Compose DNS is a bare service name (SDD 11.2): http://catalog:8000
CATALOG_SERVICE_URL=http://catalog:8000
