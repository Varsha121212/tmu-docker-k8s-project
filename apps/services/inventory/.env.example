# Copy to .env and fill in real values. .env is gitignored - never commit it.

ENV=local

DATABASE_URL=postgresql+psycopg://inventory_app:CHANGE_ME_APP@localhost:5432/bookstore
MIGRATION_DATABASE_URL=postgresql+psycopg://inventory_migrator:CHANGE_ME_MIGRATIONS@localhost:5432/bookstore

# Shared secret checked on POST /reserve and POST /release (SDD 7.3 "internal
# token"). MUST be identical to Order's INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_TOKEN
