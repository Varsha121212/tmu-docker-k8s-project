# Copy to .env and fill in real values. .env is gitignored - never commit it.

ENV=local

DATABASE_URL=postgresql+psycopg://order_app:CHANGE_ME_APP@localhost:5432/bookstore
MIGRATION_DATABASE_URL=postgresql+psycopg://order_migrator:CHANGE_ME_MIGRATIONS@localhost:5432/bookstore

JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256

# MUST be identical to Inventory's INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_TOKEN

# Compose DNS is bare service names (SDD 11.2).
CART_SERVICE_URL=http://cart:8000
INVENTORY_SERVICE_URL=http://inventory:8000
