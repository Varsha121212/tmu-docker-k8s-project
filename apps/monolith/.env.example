# Copy to .env and fill in real values. .env is gitignored - never commit it.

ENV=local

# Runtime app role (bookstore_monolith) - CRUD across identity/catalog/inventory/orders schemas.
DATABASE_URL=postgresql+psycopg://bookstore_monolith:CHANGE_ME_APP@localhost:5432/bookstore

# Migration-only role (migration_admin) - used only by Alembic, never by the running app.
MIGRATION_DATABASE_URL=postgresql+psycopg://migration_admin:CHANGE_ME_MIGRATIONS@localhost:5432/bookstore

# Memurai/Redis - cart/session state (SDD 8.3).
REDIS_URL=redis://localhost:6379/0

# JWT signing secret - generate a real random 32+ byte value for local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
