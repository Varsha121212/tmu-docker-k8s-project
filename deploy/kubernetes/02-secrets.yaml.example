# US-PLT-24 / US-PLT-13: template for deploy/kubernetes/02-secrets.yaml.
# Copy this file to `02-secrets.yaml` (gitignored - see .gitignore) and
# replace every CHANGE_ME_* value with a real one before applying. Never
# commit the real file - same convention already used for deploy/docker/.env
# vs .env.example. AC #2: no secret value may exist in plaintext in source
# control - this .example file is the only one tracked by git, and it
# contains no real values.
#
# Password consistency requirement: each *_APP_PASSWORD / *_MIGRATOR_PASSWORD
# value in postgres-credentials MUST exactly match the same password embedded
# in that service's own DATABASE_URL/MIGRATION_DATABASE_URL below - these are
# the same credential appearing in two places (the account's own definition,
# and every connection string that authenticates as it), same duplication
# pattern already used in deploy/docker/.env.
#
# DATABASE_URL host is postgres-service (US-PLT-24's headless Service) -
# Kubernetes' own same-namespace short-name DNS (SDD 11.2), not the Compose
# bare name "postgres".

apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: bookstore
type: Opaque
stringData:
  POSTGRES_USER: CHANGE_ME_postgres_superuser
  POSTGRES_PASSWORD: CHANGE_ME_postgres_superuser_password
  POSTGRES_DB: bookstore
  IDENTITY_MIGRATOR_PASSWORD: CHANGE_ME_identity_migrator_password
  IDENTITY_APP_PASSWORD: CHANGE_ME_identity_app_password
  CATALOG_MIGRATOR_PASSWORD: CHANGE_ME_catalog_migrator_password
  CATALOG_APP_PASSWORD: CHANGE_ME_catalog_app_password
  INVENTORY_MIGRATOR_PASSWORD: CHANGE_ME_inventory_migrator_password
  INVENTORY_APP_PASSWORD: CHANGE_ME_inventory_app_password
  ORDER_MIGRATOR_PASSWORD: CHANGE_ME_order_migrator_password
  ORDER_APP_PASSWORD: CHANGE_ME_order_app_password
---
apiVersion: v1
kind: Secret
metadata:
  name: identity-secrets
  namespace: bookstore
type: Opaque
stringData:
  DATABASE_URL: postgresql+psycopg://identity_app:CHANGE_ME_identity_app_password@postgres-service:5432/bookstore
  MIGRATION_DATABASE_URL: postgresql+psycopg://identity_migrator:CHANGE_ME_identity_migrator_password@postgres-service:5432/bookstore
  JWT_SECRET: CHANGE_ME_jwt_secret
---
apiVersion: v1
kind: Secret
metadata:
  name: catalog-secrets
  namespace: bookstore
type: Opaque
stringData:
  DATABASE_URL: postgresql+psycopg://catalog_app:CHANGE_ME_catalog_app_password@postgres-service:5432/bookstore
  MIGRATION_DATABASE_URL: postgresql+psycopg://catalog_migrator:CHANGE_ME_catalog_migrator_password@postgres-service:5432/bookstore
  JWT_SECRET: CHANGE_ME_jwt_secret
---
apiVersion: v1
kind: Secret
metadata:
  name: inventory-secrets
  namespace: bookstore
type: Opaque
stringData:
  DATABASE_URL: postgresql+psycopg://inventory_app:CHANGE_ME_inventory_app_password@postgres-service:5432/bookstore
  MIGRATION_DATABASE_URL: postgresql+psycopg://inventory_migrator:CHANGE_ME_inventory_migrator_password@postgres-service:5432/bookstore
  INTERNAL_SERVICE_TOKEN: CHANGE_ME_internal_service_token
---
apiVersion: v1
kind: Secret
metadata:
  name: redis-credentials
  namespace: bookstore
type: Opaque
stringData:
  # US-PLT-20 already hit this exact failure mode on vm-baseline-db: Redis's
  # protected-mode refuses all non-loopback connections until a password is
  # set, independent of any firewall/NetworkPolicy rule. Pod-to-pod traffic
  # across the cluster network is the same non-loopback scenario, so this
  # sets requirepass proactively (13-redis-workload.yaml) rather than
  # rediscovering the same bug during verification.
  REDIS_PASSWORD: CHANGE_ME_redis_password
---
apiVersion: v1
kind: Secret
metadata:
  name: cart-secrets
  namespace: bookstore
type: Opaque
stringData:
  # REDIS_URL embeds the password above, so it's secret-shaped and lives
  # here, not in the non-secret app-config ConfigMap.
  REDIS_URL: redis://:CHANGE_ME_redis_password@redis-service:6379/0
  JWT_SECRET: CHANGE_ME_jwt_secret
---
apiVersion: v1
kind: Secret
metadata:
  name: order-secrets
  namespace: bookstore
type: Opaque
stringData:
  DATABASE_URL: postgresql+psycopg://order_app:CHANGE_ME_order_app_password@postgres-service:5432/bookstore
  MIGRATION_DATABASE_URL: postgresql+psycopg://order_migrator:CHANGE_ME_order_migrator_password@postgres-service:5432/bookstore
  JWT_SECRET: CHANGE_ME_jwt_secret
  INTERNAL_SERVICE_TOKEN: CHANGE_ME_internal_service_token
